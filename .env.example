# Google Gemini & GenAI API Credentials
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_TEMPERATURE=0.2
EMBEDDING_MODEL_NAME=gemini-embedding-001

# Threshold Settings
COST_ADJUSTMENT_THRESHOLD=0.30
FRAUD_ESCALATION_THRESHOLD=1.00
CLAIM_VELOCITY_LOOKBACK_MONTHS=6
FIR_REQUIRED_LOSS_THRESHOLD=50000.0

# Observability & Tracking
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=Motor_Claim_Adjudication_Engine
